@model QuanLySan.Models.MatchPost
@{
    var applied = Model.Applications?.Count ?? 0;
}

<article class="match-card">
    <div class="match-card-icon">🤝</div>
    <div>
        <div class="d-flex justify-content-between gap-2 align-items-start">
            <h2>@Model.CourtType</h2>
            <span class="status-pill open">@Model.Status</span>
        </div>
        <p class="text-muted mb-2">@Model.Date.ToString("dd/MM") · @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</p>
        <p class="mb-2">@Model.Note</p>
        <div class="match-meta">
            <span>Cần @Model.NeededPlayers người</span>
            <span>@Model.SkillLevel</span>
            <span>@Model.PreferredGender</span>
            <span>@applied ứng tuyển</span>
        </div>
    </div>
    <a class="btn btn-outline-primary w-100" asp-controller="Match" asp-action="Details" asp-route-id="@Model.Id">Chi tiết</a>
</article>
