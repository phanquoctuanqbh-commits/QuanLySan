@{
    ViewData["Title"] = "VNPAY Demo";
    var soTien = ViewBag.SoTien as decimal? ?? 0;
    var maThamChieu = ViewBag.MaThamChieu as string ?? string.Empty;
}

<div class="ticket-layout">
    <section class="ticket-card">
        <div>
            <p class="eyebrow">Cổng thanh toán demo</p>
            <h1>VNPAY Sandbox</h1>
            <p class="text-muted mb-0">Màn hình này mô phỏng bước thanh toán VNPAY để bài có thể chạy khi chưa có merchant key thật.</p>
        </div>

        <dl class="payment-info">
            <dt>Mã giao dịch</dt>
            <dd>@maThamChieu</dd>
            <dt>Số tiền</dt>
            <dd>@soTien.ToString("N0") VND</dd>
            <dt>Trạng thái</dt>
            <dd><span class="status-pill open">Chờ xác nhận</span></dd>
        </dl>

        <form asp-action="VnPayDemoSuccess" method="post" class="d-flex gap-2 flex-wrap">
            <input type="hidden" name="soTien" value="@soTien" />
            <input type="hidden" name="maThamChieu" value="@maThamChieu" />
            <button class="btn btn-primary btn-lg" type="submit">Mô phỏng thanh toán thành công</button>
            <a class="btn btn-outline-primary btn-lg" asp-action="Index">Hủy</a>
        </form>
    </section>
</div>
