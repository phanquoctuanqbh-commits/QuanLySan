@model IEnumerable<QuanLySan.Models.CourtReport>
@{
    ViewData["Title"] = "Phiếu tố cáo";
}

<div class="section-heading">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Phiếu tố cáo</h1>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Index">Admin</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">Chưa có phiếu tố cáo nào.</div>
}
else
{
    <div class="table-responsive app-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Sân</th>
                    <th>Lý do</th>
                    <th>Nội dung</th>
                    <th>Người gửi</th>
                    <th>Ngày gửi</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="San" asp-action="Details" asp-route-id="@item.SanId">@item.San?.TenSan</a>
                        </td>
                        <td>@item.Reason</td>
                        <td class="small">@item.Description</td>
                        <td class="small">@item.UserName</td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="status-pill">@item.Status</span></td>
                        <td>
                            <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                <input type="hidden" name="id" value="@item.Id" />
                                <select name="status" class="form-select form-select-sm status-select">
                                    <option selected="@(item.Status == "Pending")">Pending</option>
                                    <option selected="@(item.Status == "Reviewing")">Reviewing</option>
                                    <option selected="@(item.Status == "Resolved")">Resolved</option>
                                    <option selected="@(item.Status == "Rejected")">Rejected</option>
                                </select>
                                <button class="btn btn-sm btn-primary" type="submit">Lưu</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
