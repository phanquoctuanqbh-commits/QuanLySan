@model QuanLySan.Models.DatSan
@{
    ViewData["Title"] = "Xác nhận QR";
}

<div class="section-heading">
    <div>
        <p class="eyebrow">Check-in sân</p>
        <h1>Xác nhận mã QR</h1>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Về dashboard</a>
</div>

<div class="booking-layout">
    <form asp-action="XacNhanQR" method="post" class="app-form">
        <h2>Nhập mã xác nhận</h2>
        <label class="form-label">Mã trên phiếu QR</label>
        <input name="maXacNhan" class="form-control text-uppercase" placeholder="VD: QR2605101234" autofocus />
        <button class="btn btn-primary btn-lg" type="submit">Xác nhận khách đến sân</button>
    </form>

    <section class="summary-panel">
        <p class="eyebrow">Kết quả</p>
        @if (Model == null)
        {
            <h2>Chưa có đơn được quét</h2>
            <p class="text-muted">Mở phiếu QR của người dùng, nhập mã trên phiếu để chuyển đơn sang trạng thái đã xác nhận.</p>
        }
        else
        {
            <h2>@Model.MaXacNhan</h2>
            <dl class="payment-info">
                <dt>Sân</dt>
                <dd>@Model.San?.TenSan</dd>
                <dt>Ngày</dt>
                <dd>@Model.Ngay.ToString("dd/MM/yyyy")</dd>
                <dt>Giờ</dt>
                <dd>@Model.GioBatDau.ToString(@"hh\:mm") - @Model.GioKetThuc.ToString(@"hh\:mm")</dd>
                <dt>Trạng thái</dt>
                <dd><span class="status-pill">@Model.TrangThai</span></dd>
            </dl>
        }
    </section>
</div>
