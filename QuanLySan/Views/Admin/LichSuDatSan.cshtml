@model IEnumerable<QuanLySan.Models.DatSan>
@{
    ViewData["Title"] = "Lịch sử đặt sân";
}

<div class="section-heading">
    <div>
        <p class="eyebrow">Quản trị</p>
        <h1>Lịch sử đặt sân của user</h1>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Quay lại quản trị</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">Chưa có đơn đặt sân nào.</div>
}
else
{
    <div class="table-responsive app-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>User</th>
                    <th>Sân</th>
                    <th>Loại sân</th>
                    <th>Ngày</th>
                    <th>Giờ</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.Id</td>
                        <td class="small">@item.UserId</td>
                        <td>@item.San?.TenSan</td>
                        <td>@item.San?.LoaiSan?.TenLoai</td>
                        <td>@item.Ngay.ToString("dd/MM/yyyy")</td>
                        <td>@item.GioBatDau.ToString(@"hh\:mm") - @item.GioKetThuc.ToString(@"hh\:mm")</td>
                        <td class="text-end">@item.TongTien.ToString("N0") VND</td>
                        <td><span class="status-pill">@item.TrangThai</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
