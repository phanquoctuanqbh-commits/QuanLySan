@model IEnumerable<QuanLySan.Models.BaoTriSan>
@{
    ViewData["Title"] = "Bảo trì sân";
    var sans = ViewBag.Sans as IEnumerable<QuanLySan.Models.San> ?? Enumerable.Empty<QuanLySan.Models.San>();
}

<div class="section-heading">
    <div>
        <p class="eyebrow">Vận hành</p>
        <h1>Lịch bảo trì sân</h1>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Về dashboard</a>
</div>

<div class="booking-layout">
    <form asp-action="CreateBaoTri" method="post" class="app-form">
        <h2>Thêm khung bảo trì</h2>
        <label class="form-label">Sân</label>
        <select name="SanId" class="form-select">
            @foreach (var san in sans)
            {
                <option value="@san.Id">@san.TenSan</option>
            }
        </select>

        <label class="form-label">Ngày</label>
        <input name="Ngay" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />

        <div class="row g-2">
            <div class="col-md-6">
                <label class="form-label">Bắt đầu</label>
                <input name="GioBatDau" class="form-control" type="time" value="12:00" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Kết thúc</label>
                <input name="GioKetThuc" class="form-control" type="time" value="13:00" />
            </div>
        </div>

        <label class="form-label">Lý do</label>
        <input name="LyDo" class="form-control" placeholder="Vệ sinh sân, thay đèn, sửa mặt sân..." />

        <button class="btn btn-primary btn-lg" type="submit">Thêm bảo trì</button>
    </form>

    <section class="summary-panel">
        <p class="eyebrow">Tác dụng</p>
        <h2>Chặn đặt trùng bảo trì</h2>
        <p class="text-muted">Khi sân có lịch bảo trì, người dùng sẽ không đặt được khung giờ đó và lịch sân sẽ hiện màu đỏ.</p>
    </section>
</div>

<div class="table-responsive app-table mt-4">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Sân</th>
                <th>Ngày</th>
                <th>Giờ</th>
                <th>Lý do</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.San?.TenSan</td>
                    <td>@item.Ngay.ToString("dd/MM/yyyy")</td>
                    <td>@item.GioBatDau.ToString(@"hh\:mm") - @item.GioKetThuc.ToString(@"hh\:mm")</td>
                    <td>@item.LyDo</td>
                    <td><span class="status-pill @(item.TrangThai ? "closed" : "")">@(item.TrangThai ? "Đang khóa" : "Đã tắt")</span></td>
                    <td class="text-end">
                        <form asp-action="ToggleBaoTri" asp-route-id="@item.Id" method="post">
                            <button class="btn btn-sm btn-outline-primary" type="submit">Bật/tắt</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
