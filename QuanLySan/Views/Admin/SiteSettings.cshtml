@model QuanLySan.Models.SiteSetting
@{
    ViewData["Title"] = "Thông tin website";
}

<div class="section-heading">
    <div>
        <p class="eyebrow">Database settings</p>
        <h1>Thông tin website</h1>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Về dashboard</a>
</div>

<form asp-action="SiteSettings" method="post" class="app-form">
    <input type="hidden" asp-for="Id" />

    <label class="form-label">Business name</label>
    <input asp-for="BusinessName" class="form-control" />

    <label class="form-label">Address</label>
    <input asp-for="Address" class="form-control" />

    <label class="form-label">Phone number</label>
    <input asp-for="PhoneNumber" class="form-control" />

    <label class="form-label">Email</label>
    <input asp-for="Email" class="form-control" />

    <label class="form-label">Opening hours</label>
    <input asp-for="OpeningHours" class="form-control" />

    <label class="form-label">Google Map embed URL</label>
    <input asp-for="MapEmbedUrl" class="form-control" />

    <label class="form-label">Description</label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>

    <button class="btn btn-primary btn-lg" type="submit">Lưu vào database</button>
</form>
