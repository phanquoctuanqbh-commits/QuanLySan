@{
    ViewData["Title"] = "Đặt sân thể thao";
}

<section class="hero-band">
    <div>
        <p class="eyebrow">Hệ thống đặt sân và quản lý sân</p>
        <h1>Đặt sân nhanh, quản lý gọn, theo dõi lịch rõ ràng.</h1>
        <p class="hero-copy">Tìm sân phù hợp, thanh toán bằng tài khoản nội bộ và theo dõi lịch đặt trong một nơi.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary btn-lg" asp-controller="San" asp-action="Index">Đặt sân ngay</a>
            <a class="btn btn-outline-primary btn-lg" asp-controller="San" asp-action="TimKiem">🔍 Tìm sân nâng cao</a>
            <a class="btn btn-outline-secondary btn-lg" asp-controller="DatSan" asp-action="Calendar">Xem lịch đặt</a>
        </div>
    </div>
    <div class="hero-panel">
        <div class="metric"><span>3+</span><small>Loại sân</small></div>
        <div class="metric"><span>24/7</span><small>Đặt lịch</small></div>
        <div class="metric"><span>Ví</span><small>Thanh toán</small></div>
    </div>
</section>

<div class="section-heading">
    <div>
        <p class="eyebrow">Ưu đãi hôm nay</p>
        <h2>Sân đẹp và voucher nổi bật</h2>
    </div>
    <a class="btn btn-sm btn-outline-primary" asp-controller="San" asp-action="Index">Xem tất cả</a>
</div>

<section class="promo-showcase" aria-label="Quảng cáo sân và voucher">
    <div class="promo-track">
        <article class="promo-slide" style="--promo-image: url('https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=1200&q=80')">
            <div>
                <span>Camp Nou style</span>
                <h3>Voucher giảm 20%</h3>
                <p>Áp dụng cho khung giờ sáng từ thứ 2 đến thứ 5.</p>
            </div>
        </article>
        <article class="promo-slide" style="--promo-image: url('https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=1200&q=80')">
            <div>
                <span>Wembley night</span>
                <h3>Tặng 1 giờ đèn</h3>
                <p>Đặt sân buổi tối, nhận ưu đãi chiếu sáng miễn phí.</p>
            </div>
        </article>
        <article class="promo-slide" style="--promo-image: url('https://images.unsplash.com/photo-1577223625816-7546f13df25d?auto=format&fit=crop&w=1200&q=80')">
            <div>
                <span>World class court</span>
                <h3>Combo đội nhóm</h3>
                <p>Giảm 15% cho đơn đặt từ 3 khung giờ trở lên.</p>
            </div>
        </article>
        <article class="promo-slide" style="--promo-image: url('https://images.unsplash.com/photo-1517927033932-b3d18e61fb3a?auto=format&fit=crop&w=1200&q=80')">
            <div>
                <span>Training arena</span>
                <h3>Mã SPORT50</h3>
                <p>Giảm ngay 50.000 VND cho lần đặt sân tiếp theo.</p>
            </div>
        </article>
        <article class="promo-slide" style="--promo-image: url('https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=1200&q=80')">
            <div>
                <span>Camp Nou style</span>
                <h3>Voucher giảm 20%</h3>
                <p>Áp dụng cho khung giờ sáng từ thứ 2 đến thứ 5.</p>
