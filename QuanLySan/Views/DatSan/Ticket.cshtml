@model QuanLySan.Models.DatSan
@{
    ViewData["Title"] = "Phiếu đặt sân QR";
}

<div class="ticket-layout">
    <section class="ticket-card">
        <div>
            <p class="eyebrow">Phiếu xác nhận</p>
            <h1>@Model.MaXacNhan</h1>
            <p class="text-muted mb-0">Đưa mã này cho quản trị viên khi đến sân để xác nhận nhanh.</p>
        </div>

        <canvas id="qrCanvas" class="qr-canvas" width="220" height="220" data-code="@Model.MaXacNhan"></canvas>

        <dl class="payment-info">
            <dt>Sân</dt>
            <dd>@Model.San?.TenSan</dd>
            <dt>Loại sân</dt>
            <dd>@Model.San?.LoaiSan?.TenLoai</dd>
            <dt>Ngày</dt>
            <dd>@Model.Ngay.ToString("dd/MM/yyyy")</dd>
            <dt>Giờ</dt>
            <dd>@Model.GioBatDau.ToString(@"hh\:mm") - @Model.GioKetThuc.ToString(@"hh\:mm")</dd>
            <dt>Giảm giá</dt>
            <dd>@Model.GiamGia.ToString("N0") VND</dd>
            <dt>Thanh toán</dt>
            <dd>@Model.TongTien.ToString("N0") VND</dd>
            <dt>Trạng thái</dt>
            <dd><span class="status-pill">@Model.TrangThai</span></dd>
        </dl>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" asp-action="MyBookings">Đơn của tôi</a>
            <a class="btn btn-outline-primary" asp-controller="DatSan" asp-action="Calendar">Xem lịch sân</a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const canvas = document.getElementById('qrCanvas');
        const ctx = canvas.getContext('2d');
        const code = canvas.dataset.code || 'SPORT';
        const size = 11;
        const cell = canvas.width / size;

        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        function drawFinder(x, y) {
            ctx.fillStyle = '#101828';
            ctx.fillRect(x * cell, y * cell, cell * 3, cell * 3);
            ctx.fillStyle = '#fff';
            ctx.fillRect((x + .6) * cell, (y + .6) * cell, cell * 1.8, cell * 1.8);
            ctx.fillStyle = '#101828';
            ctx.fillRect((x + 1.1) * cell, (y + 1.1) * cell, cell * .8, cell * .8);
        }

        drawFinder(0, 0);
        drawFinder(8, 0);
        drawFinder(0, 8);

        let seed = [...code].reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
        for (let y = 0; y < size; y++) {
            for (let x = 0; x < size; x++) {
                const inFinder = (x < 3 && y < 3) || (x > 7 && y < 3) || (x < 3 && y > 7);
                if (inFinder) continue;
                seed = (seed * 9301 + 49297) % 233280;
                if (seed % 3 !== 0) {
                    ctx.fillStyle = '#101828';
                    ctx.fillRect(x * cell + 1, y * cell + 1, cell - 2, cell - 2);
                }
            }
        }
    </script>
}
