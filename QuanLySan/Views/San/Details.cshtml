@model QuanLySan.Models.San
@{
    ViewData["Title"] = Model.TenSan;
    DateTime ngay = ViewBag.Ngay;
    var reviews = ViewBag.Reviews as IEnumerable<QuanLySan.Models.DanhGiaSan> ?? Enumerable.Empty<QuanLySan.Models.DanhGiaSan>();
    double averageRating = ViewBag.AverageRating;
    int ratingCount = ViewBag.RatingCount;
    var userEmails = ViewBag.UserEmails as Dictionary<string, string> ?? new Dictionary<string, string>();
    var bookedSlots = ViewBag.BookedSlots as IEnumerable<QuanLySan.Models.TimeSpanRange> ?? Enumerable.Empty<QuanLySan.Models.TimeSpanRange>();

    var courtType = Model.LoaiSan?.TenLoai ?? "Football";
    var galleryImages = new List<string>();
    
    if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
    {
        var paths = Model.HinhAnh.Split(';', StringSplitOptions.RemoveEmptyEntries);
        foreach (var path in paths)
        {
            if (path.Contains(".svg"))
            {
                galleryImages.Add(courtType switch {
                    "Football" => "/images/Etihad.jpg",
                    "Badminton" => "/images/scl.jpg",
                    "Tennis" => "/images/stn.jpg",
                    "Pickleball" => "/images/spick.jpg",
                    "Volleyball" => "/images/voll.jfif",
                    "Golf" => "/images/goft.jfif",
                    "Table Tennis" => "/images/tt.jfif",
                    _ => "/images/sbr.jpg"
                });
            }
            else
            {
                galleryImages.Add(path);
            }
        }
    }
    
    if (!galleryImages.Any())
    {
        galleryImages.Add("/images/sbr.jpg");
    }
    
    // If only one image is present, append high-quality Unsplash sport photos as gallery enhancements
    if (galleryImages.Count == 1)
    {
        if (courtType == "Football")
        {
            galleryImages.Add("https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1517927033932-b3d18e61fb3a?auto=format&fit=crop&w=1200&q=80");
        }
        else if (courtType == "Badminton")
        {
            galleryImages.Add("https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1521537634180-60a1e2f384a8?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1540497077202-7c8a3999166f?auto=format&fit=crop&w=1200&q=80");
        }
        else if (courtType == "Tennis")
        {
            galleryImages.Add("https://images.unsplash.com/photo-1595435934249-5df7ed86e1c0?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1622279457486-62dcc4a4efb3?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1577223625816-7546f13df25d?auto=format&fit=crop&w=1200&q=80");
        }
        else if (courtType == "Pickleball")
        {
            galleryImages.Add("https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1595435934249-5df7ed86e1c0?auto=format&fit=crop&w=1200&q=80");
        }
        else if (courtType == "Volleyball")
        {
            galleryImages.Add("https://images.unsplash.com/photo-1592656094267-764a45159575?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1547347298-4074fc3086a0?auto=format&fit=crop&w=1200&q=80");
        }
        else if (courtType == "Golf")
        {
            galleryImages.Add("https://images.unsplash.com/photo-1535131749006-b7f58c99034b?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1587174486073-ae5e5cff23aa?auto=format&fit=crop&w=1200&q=80");
        }
        else
        {
            galleryImages.Add("https://images.unsplash.com/photo-1517649763962-0c623066013b?auto=format&fit=crop&w=1200&q=80");
            galleryImages.Add("https://images.unsplash.com/photo-1540497077202-7c8a3999166f?auto=format&fit=crop&w=1200&q=80");
        }
    }
}

<!-- Premium Interactive Gallery Header -->
<div class="gallery-wrapper mb-4">
    <div class="main-preview-box">
        <img id="mainPreview" src="@galleryImages[0]" alt="@Model.TenSan" />
        <div class="glass-overlay-meta">
            <p class="eyebrow mb-1 text-white opacity-75">Sân vận động > @Model.LoaiSan?.TenLoai</p>
            <h1 class="h3 fw-bold text-white mb-2">@Model.TenSan</h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="status-pill @(Model.TrangThai ? "open" : "closed")">
                    @(Model.TrangThai ? "Đang mở cửa" : "Tạm ngưng")
                </span>
                <span class="badge bg-light text-dark fw-bold">@Model.Gia.ToString("N0") VND / Giờ</span>
                @if (ratingCount > 0)
                {
                    <span class="text-warning fw-bold small">★ @averageRating.ToString("0.0") (@ratingCount đánh giá)</span>
                }
            </div>
        </div>
    </div>
    <div class="thumbnail-strip">
        @for (int i = 0; i < galleryImages.Count; i++)
        {
            <div class="thumbnail-item @(i == 0 ? "active" : "")" onclick="changePreview(this, '@galleryImages[i]')">
                <img src="@galleryImages[i]" alt="Thumbnail @(i+1)" />
            </div>
        }
    </div>
</div>

<!-- Main Details Layout Grid -->
<div class="details-grid">
    <!-- Left Column (Description, Availability, Reviews) -->
    <section class="detail-section">
        <!-- 1. Description Card -->
        <article class="detail-card">
            <h2 class="h5 fw-bold border-bottom pb-2 mb-3">Mô tả</h2>
            <p style="white-space: pre-line; line-height: 1.6;">@Model.MoTa</p>
            
            <div class="mt-4 pt-3 border-top">
                <h3 class="h6 fw-bold mb-2">📍 Địa điểm sân</h3>
                <p class="text-muted mb-0">@Model.DiaChi</p>
            </div>
        </article>

        <!-- 2. Daily Timeline Schedule availability -->
        <article class="detail-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom pb-2 mb-3">
                <h2 class="h5 fw-bold mb-0">Lịch trống</h2>
                
                <!-- Date availability picker -->
                <form method="get" asp-action="Details" asp-route-id="@Model.Id" class="d-flex align-items-center gap-2">
                    <label class="small text-nowrap fw-bold text-muted mb-0">Xem ngày:</label>
                    <input type="date" name="ngay" class="form-control form-control-sm" 
                           value="@ngay.ToString("yyyy-MM-dd")" 
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" 
                           onchange="this.form.submit()" />
                </form>
            </div>

            <p class="small text-muted mb-3">Lịch trống trong ngày <strong>@ngay.ToString("dd/MM/yyyy")</strong>. Nhấp vào các khung giờ xanh lá bên dưới để đặt lịch sân ngay lập tức:</p>

            <div class="availability-timeline">
                @for (int h = 6; h <= 22; h++)
                {
                    var start = new TimeSpan(h, 0, 0);
                    var end = new TimeSpan(h + 1, 0, 0);

                    // Check conflict with bookings or maintenance
                    var bookingConflict = bookedSlots.FirstOrDefault(x => start < x.End && end > x.Start);

                    if (bookingConflict != null)
                    {
                        if (bookingConflict.Label == "Bảo trì")
                        {
                            <span class="timeline-slot maintenance" title="Đang bảo trì từ @bookingConflict.Start.ToString(@"hh\:mm") đến @bookingConflict.End.ToString(@"hh\:mm")">
                                🛠️ @h:00
                            </span>
                        }
                        else
                        {
                            <span class="timeline-slot busy" title="Khung giờ đã được đặt từ @bookingConflict.Start.ToString(@"hh\:mm") đến @bookingConflict.End.ToString(@"hh\:mm")">
                                🔒 @h:00
                            </span>
                        }
                    }
                    else
                    {
                        if (Model.TrangThai)
                        {
                            <a asp-controller="DatSan" asp-action="Create" 
                               asp-route-sanId="@Model.Id" 
                               asp-route-ngay="@ngay.ToString("yyyy-MM-dd")" 
                               asp-route-gioBatDau="@start.ToString(@"hh\:mm\:ss")" 
                               asp-route-gioKetThuc="@end.ToString(@"hh\:mm\:ss")" 
                               class="timeline-slot free" 
                               title="Giờ trống: Đặt ngay từ @h:00 - @(h+1):00">
                                🟢 @h:00
                            </a>
                        }
                        else
                        {
                            <span class="timeline-slot busy" title="Sân đang tạm ngừng hoạt động">
                                🔒 @h:00
                            </span>
                        }
                    }
                }
            </div>
            
            <div class="d-flex gap-4 mt-3 small text-muted">
                <span>🟢 Trống (Nhấn đặt)</span>
                <span>🔒 Đã được đặt</span>
                <span>🛠️ Đang bảo trì</span>
            </div>
        </article>

        <!-- 3. Reviews & Ratings Section -->
        <article class="detail-card">
            <h2 class="h5 fw-bold border-bottom pb-2 mb-3 d-flex justify-content-between align-items-center">
                <span>Đánh giá</span>
                @if (ratingCount > 0)
                {
                    <span class="badge bg-warning-subtle text-dark border border-warning fs-6">★ @averageRating.ToString("0.0") / 5</span>
                }
            </h2>

            @if (!reviews.Any())
            {
                <div class="py-4 text-center text-muted">
                    <p class="mb-0">Chưa có bình luận hay đánh giá nào cho sân này.</p>
                    <small>Người chơi đặt sân và hoàn tất trận đấu sẽ có thể đánh giá và bình luận tại đây.</small>
                </div>
            }
            else
            {
                <div class="reviews-container">
                    @foreach (var review in reviews)
                    {
                        <div class="review-item">
                            <div class="review-meta">
                                <span class="review-user">👤 @(userEmails.TryGetValue(review.UserId, out var email) ? email : "Khách hàng")</span>
                                <span class="review-date">@review.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="review-rating text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.SoSao)
                                    {
                                        <span>★</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-50">★</span>
                                    }
                                }
                            </div>
                            <p class="review-comment">@review.BinhLuan</p>
                        </div>
                    }
                </div>
            }
        </article>
    </section>

    <!-- Right Column (Google Map, Quick Actions) -->
    <aside class="detail-section">
        <!-- Map and Address Section -->
        <article class="detail-card">
            <h2 class="h5 fw-bold mb-3">📍 Bản đồ</h2>
            <div class="map-container mb-3">
                @if (Model.Latitude != 0 && Model.Longitude != 0)
                {
                    <iframe
                        title="Bản đồ vị trí sân @Model.TenSan"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        src="https://maps.google.com/maps?q=@(Model.Latitude),@(Model.Longitude)&t=&z=16&ie=UTF8&iwloc=&output=embed">
                    </iframe>
                }
                else
                {
                    <iframe
                        title="Bản đồ mặc định"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        src="https://maps.google.com/maps?q=@(Uri.EscapeDataString(Model.DiaChi + " Ho Chi Minh"))&t=&z=16&ie=UTF8&iwloc=&output=embed">
                    </iframe>
                }
            </div>
            <div class="small">
                <strong>Địa chỉ:</strong> @Model.DiaChi
                @if (Model.Latitude != 0)
                {
                    <br /><strong class="text-muted">Tọa độ GPS:</strong> <span class="text-muted">@Model.Latitude.ToString("0.0000"), @Model.Longitude.ToString("0.0000")</span>
                }
            </div>
        </article>

        <!-- Quick booking / Support sidebar -->
        <article class="detail-card app-form bg-light-subtle">
            <h2 class="h6 fw-bold mb-3 text-uppercase text-muted">Đặt nhanh</h2>
            
            <p class="small text-muted mb-3">Bạn có thể chọn ngày và nhấn trực tiếp vào khung giờ trống ở bảng bên trái hoặc chọn đặt linh hoạt tại đây.</p>
            
            @if (Model.TrangThai)
            {
                <a class="btn btn-success btn-lg d-block text-center w-100 mb-3" 
                   asp-controller="DatSan" asp-action="Create" 
                   asp-route-sanId="@Model.Id" 
                   asp-route-ngay="@ngay.ToString("yyyy-MM-dd")">
                    Đặt sân ngày @ngay.ToString("dd/MM")
                </a>
            }
            else
            {
                <button class="btn btn-secondary btn-lg d-block w-100 mb-3" disabled>Tạm ngưng nhận lịch</button>
            }

            @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && !User.IsInRole("Owner") && !User.IsInRole("ChuSan"))
            {
                <a class="btn btn-outline-danger d-block text-center w-100 mb-3"
                   asp-controller="Report"
                   asp-action="Create"
                   asp-route-sanId="@Model.Id">
                    Tố cáo sân
                </a>
            }

            <div class="border-top pt-3 mt-2 small">
                <span class="fw-bold d-block mb-1">📞 SportHub Hỗ trợ 24/7</span>
                <span class="text-muted d-block">Hotline: <strong>0909 123 456</strong></span>
                <span class="text-muted d-block">Giờ mở cửa: 06:00 - 23:00 hàng ngày</span>
            </div>
        </article>
    </aside>
</div>

@section Scripts {
    <script>
        function changePreview(element, imageUrl) {
            const mainPreview = document.getElementById("mainPreview");
            
            // Smooth transition: fade out, swap source, fade in
            mainPreview.style.opacity = 0.25;
            setTimeout(() => {
                mainPreview.src = imageUrl;
                mainPreview.style.opacity = 1;
            }, 120);
            
            // Toggle active classes on thumbnails
            document.querySelectorAll(".thumbnail-item").forEach(item => {
                item.classList.remove("active");
            });
            element.classList.add("active");
        }
    </script>
}
