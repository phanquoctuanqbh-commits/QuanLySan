@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="booking-layout">
    <aside class="summary-panel">
        <p class="eyebrow">Bảo mật</p>
        <h1>Đặt lại mật khẩu</h1>
        <p>Nhập email tài khoản và mật khẩu mới. Mật khẩu cần tối thiểu 6 ký tự theo cấu hình hiện tại.</p>
    </aside>

    <form method="post" class="app-form">
        <h2>Mật khẩu mới</h2>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />

        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>

        <label asp-for="Input.Password" class="form-label">Mật khẩu mới</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Nhập mật khẩu mới" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>

        <label asp-for="Input.ConfirmPassword" class="form-label">Nhập lại mật khẩu</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

        <button type="submit" class="btn btn-primary btn-lg">Cập nhật mật khẩu</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
