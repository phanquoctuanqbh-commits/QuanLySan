@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="booking-layout">
    <aside class="summary-panel">
        <p class="eyebrow">Khôi phục tài khoản</p>
        <h1>Quên mật khẩu?</h1>
        <p>Nhập email đã đăng ký, hệ thống sẽ tạo liên kết đặt lại mật khẩu cho tài khoản của bạn.</p>
    </aside>

    <form method="post" class="app-form">
        <h2>Lấy lại mật khẩu</h2>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>

        <button type="submit" class="btn btn-primary btn-lg">Tạo liên kết đặt lại</button>
        <a asp-page="./Login">Quay lại đăng nhập</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
