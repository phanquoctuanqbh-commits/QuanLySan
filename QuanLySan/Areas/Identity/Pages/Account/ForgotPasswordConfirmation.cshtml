@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Đã tạo liên kết đặt lại mật khẩu";
}

<div class="booking-layout">
    <aside class="summary-panel">
        <p class="eyebrow">Khôi phục tài khoản</p>
        <h1>Kiểm tra yêu cầu</h1>
        <p>Nếu email tồn tại trong hệ thống, liên kết đặt lại mật khẩu đã được tạo.</p>
    </aside>

    <section class="app-form">
        <h2>Liên kết đặt lại mật khẩu</h2>
        @if (!string.IsNullOrWhiteSpace(Model.ResetLink))
        {
            <div class="alert alert-info mb-0">
                Dự án đang dùng email giả lập, nên bạn có thể bấm trực tiếp liên kết bên dưới để demo.
            </div>
            <a class="btn btn-primary btn-lg" href="@Model.ResetLink">Mở trang đặt lại mật khẩu</a>
            <code class="reset-link">@Model.ResetLink</code>
        }
        else
        {
            <p class="text-muted mb-0">Vì lý do bảo mật, hệ thống không thông báo email có tồn tại hay không.</p>
        }
        <a asp-page="./Login">Quay lại đăng nhập</a>
    </section>
</div>
